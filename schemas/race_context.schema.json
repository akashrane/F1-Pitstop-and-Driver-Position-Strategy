{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "race_context.schema.json",
  "title": "Race context",
  "description": "One row per race with circuit, race-start weather, and post-race context outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["season", "round_number", "session_key", "meeting_key", "circuit_key", "circuit_id", "circuit_short_name", "country_code", "country_name", "location", "session_start_utc", "start_weather_observed_at_utc", "start_air_temperature_c", "start_track_temperature_c", "start_humidity_pct", "start_pressure_mbar", "start_rainfall", "start_wind_speed_ms", "winner_laps_completed", "safety_car_deployments", "virtual_safety_car_deployments", "source", "source_url", "retrieved_at_utc", "validation_status"],
  "properties": {
    "season": {"type": "integer", "minimum": 1950, "x-role": "identifier"},
    "round_number": {"type": "integer", "minimum": 1, "x-role": "identifier"},
    "session_key": {"type": ["integer", "null"], "x-role": "identifier"},
    "meeting_key": {"type": ["integer", "null"], "x-role": "identifier"},
    "circuit_key": {"type": ["integer", "null"], "x-feature-time": "pre_race"},
    "circuit_id": {"type": ["string", "null"], "x-feature-time": "pre_race"},
    "circuit_short_name": {"type": ["string", "null"], "x-feature-time": "pre_race"},
    "country_code": {"type": ["string", "null"], "x-feature-time": "pre_race"},
    "country_name": {"type": ["string", "null"], "x-feature-time": "pre_race"},
    "location": {"type": ["string", "null"], "x-feature-time": "pre_race"},
    "session_start_utc": {"type": ["string", "null"], "format": "date-time", "x-feature-time": "pre_race"},
    "start_weather_observed_at_utc": {"type": ["string", "null"], "format": "date-time", "x-role": "observation_time"},
    "start_air_temperature_c": {"type": ["number", "null"], "x-unit": "celsius", "x-feature-time": "race_start"},
    "start_track_temperature_c": {"type": ["number", "null"], "x-unit": "celsius", "x-feature-time": "race_start"},
    "start_humidity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "x-unit": "percent", "x-feature-time": "race_start"},
    "start_pressure_mbar": {"type": ["number", "null"], "x-unit": "millibar", "x-feature-time": "race_start"},
    "start_rainfall": {"type": ["boolean", "null"], "x-feature-time": "race_start"},
    "start_wind_speed_ms": {"type": ["number", "null"], "minimum": 0, "x-unit": "metres_per_second", "x-feature-time": "race_start"},
    "winner_laps_completed": {"type": ["integer", "null"], "minimum": 0, "x-feature-time": "post_race"},
    "safety_car_deployments": {"type": ["integer", "null"], "minimum": 0, "x-feature-time": "post_race"},
    "virtual_safety_car_deployments": {"type": ["integer", "null"], "minimum": 0, "x-feature-time": "post_race"},
    "source": {"type": "string", "enum": ["jolpica", "openf1"]},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "validation_status": {"type": "string", "enum": ["verified", "warning", "quarantined", "unavailable"]}
  }
}
